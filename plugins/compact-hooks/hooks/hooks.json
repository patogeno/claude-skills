{
  "description": "compact-hooks: restore orientation after compaction, log compaction summaries.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/compact-hooks.js", "post-compact"],
            "timeout": 5
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/compact-hooks.js", "log-summary"],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
